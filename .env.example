# Copier en .env (ignoré par git). Aucun secret ici : voir ./secrets/ (docs/installation.md).

# Identifiant du tenant Microsoft 365 (le bucket S3 est atlas-<tenant>).
BACKUP365_TENANT_ID=
# URL du stockage S3 ; avec le profil minio : http://minio:9000
BACKUP365_S3_ENDPOINT=
# Facultatif : région S3 (eu-west-3 par défaut).
#BACKUP365_S3_REGION=
# Facultatif : port publié sur 127.0.0.1 (3000), niveau de journal (info).
#BACKUP365_PORT=3000
#LOG_LEVEL=info
# Facultatif : tableau de bord (26 h ; mail,onedrive,sharepoint), cache du recensement des sites (60 min).
#BACKUP365_STATUS_MAX_AGE_HOURS=26
#BACKUP365_STATUS_WORKLOADS=mail,onedrive,sharepoint
#BACKUP365_CATALOG_CACHE_MINUTES=60
# Facultatif : intervalle d'indexation de la recherche, en minutes (60).
#BACKUP365_INDEX_INTERVAL_MINUTES=60
# Facultatif : intervalle d'écriture des ancres du journal d'audit, en minutes (60).
#BACKUP365_AUDIT_ANCHOR_INTERVAL_MIN=60
