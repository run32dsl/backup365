# Copier en .env dans le dossier du projet (ignoré par git, jamais commité) :
# il contient des secrets. Exemples génériques : remplacer par vos valeurs.

# Adresse LAN du NAS sur laquelle publier le port. Jamais 0.0.0.0 (voir l'avertissement du guide).
BACKUP365_BIND_ADDRESS=192.168.1.10
#BACKUP365_PORT=3000
# Dossier partagé des données de la console (journal d'audit, index de recherche).
#BACKUP365_DATA_PATH=/volume1/docker/backup365/data

# Digest de l'image publiée (sha256:...), à relever avant le démarrage (étape 4 du guide).
BACKUP365_IMAGE_DIGEST=sha256:a-relever

# Identifiant du tenant Microsoft 365 (le bucket S3 est atlas-<tenant>).
BACKUP365_TENANT_ID=00000000-0000-0000-0000-000000000000
# Stockage S3 qui contient déjà les sauvegardes Atlas, joignable depuis le NAS.
BACKUP365_S3_ENDPOINT=http://192.168.1.20:9000
#BACKUP365_S3_REGION=eu-west-3
BACKUP365_S3_ACCESS_KEY_ID=exemple-cle-acces
BACKUP365_S3_SECRET_ACCESS_KEY=exemple-cle-secrete
# Phrase de chiffrement Atlas (14 octets au moins).
BACKUP365_ENCRYPTION_PASSPHRASE=exemple-phrase-de-chiffrement
